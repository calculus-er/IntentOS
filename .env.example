GROQ_API_KEY=your_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
NOTES_FOLDER_PATH=./mock_system_files/DSA_Notes
# MIC_DEVICE_INDEX=3
# Longer silence wait before auto end-of-utterance (noisy rooms); still prefer Ctrl+E to finish.
# VOICE_SILENCE_TIMEOUT_SEC=3.5
# openWakeWord sensitivity: lower = easier wake (more false triggers). Try 0.28–0.35 in noise.
# OWW_SCORE_THRESHOLD=0.32
# If mic numbering differs for PyAudio vs sounddevice, set explicitly for wake (usually leave unset):
# OWW_DEVICE_INDEX=1
